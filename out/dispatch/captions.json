[
 {
  "text": "A mountain of rock near McCarthy",
  "start": 0.0,
  "end": 2.5700000000000003,
  "seg": 0
 },
 {
  "text": "sped up twice.",
  "start": 2.6,
  "end": 4.44,
  "seg": 0
 },
 {
  "text": "Not once in the study, but",
  "start": 5.52,
  "end": 7.77,
  "seg": 1
 },
 {
  "text": "twice each year.",
  "start": 7.8,
  "end": 9.52,
  "seg": 1
 },
 {
  "text": "Sentinel One radar mapped seven",
  "start": 11.0,
  "end": 13.99,
  "seg": 2
 },
 {
  "text": "rock glaciers near McCarthy from",
  "start": 14.02,
  "end": 16.39,
  "seg": 2
 },
 {
  "text": "twenty eighteen through twenty",
  "start": 16.42,
  "end": 17.77,
  "seg": 2
 },
 {
  "text": "twenty two.",
  "start": 17.8,
  "end": 18.66,
  "seg": 2
 },
 {
  "text": "They are rivers of rock and",
  "start": 19.76,
  "end": 21.93,
  "seg": 3
 },
 {
  "text": "ice.",
  "start": 21.96,
  "end": 22.66,
  "seg": 3
 },
 {
  "text": "Parts of Sourdough Peak moved more",
  "start": 23.52,
  "end": 25.61,
  "seg": 4
 },
 {
  "text": "than one hundred sixty centimeters",
  "start": 25.64,
  "end": 27.59,
  "seg": 4
 },
 {
  "text": "a year.",
  "start": 27.62,
  "end": 28.41,
  "seg": 4
 },
 {
  "text": "A nearby glacier moved less than",
  "start": 28.44,
  "end": 32.03,
  "seg": 5
 },
 {
  "text": "half as fast in the university",
  "start": 32.06,
  "end": 33.89,
  "seg": 5
 },
 {
  "text": "summary.",
  "start": 33.92,
  "end": 34.620000000000005,
  "seg": 5
 },
 {
  "text": "Photogrammetry checked more than",
  "start": 35.8,
  "end": 37.55,
  "seg": 6
 },
 {
  "text": "sixteen thousand Sourdough Peak",
  "start": 37.58,
  "end": 39.87,
  "seg": 6
 },
 {
  "text": "pixels.",
  "start": 39.9,
  "end": 40.6,
  "seg": 6
 },
 {
  "text": "R, 0.842.",
  "start": 41.64,
  "end": 43.44,
  "seg": 7
 },
 {
  "text": "Mean absolute error, 10.72 centimeters",
  "start": 44.18,
  "end": 47.95,
  "seg": 7
 },
 {
  "text": "per year.",
  "start": 47.98,
  "end": 48.7,
  "seg": 7
 },
 {
  "text": "Researchers fixed two components.",
  "start": 49.84,
  "end": 51.9,
  "seg": 8
 },
 {
  "text": "Unsupervised separation yielded",
  "start": 52.96,
  "end": 55.19,
  "seg": 8
 },
 {
  "text": "a long crawl and seasonal pulse",
  "start": 55.22,
  "end": 57.55,
  "seg": 8
 },
 {
  "text": "they interpreted.",
  "start": 57.58,
  "end": 58.32,
  "seg": 8
 },
 {
  "text": "That pulse peaked after snowmelt",
  "start": 59.76,
  "end": 61.949999999999996,
  "seg": 9
 },
 {
  "text": "and again with later rain.",
  "start": 61.98,
  "end": 63.94,
  "seg": 9
 },
 {
  "text": "Four measured years lagged snowmelt",
  "start": 65.26,
  "end": 67.97,
  "seg": 10
 },
 {
  "text": "by seventy two to eighty four",
  "start": 68.0,
  "end": 69.75,
  "seg": 10
 },
 {
  "text": "days.",
  "start": 69.78,
  "end": 70.48,
  "seg": 10
 },
 {
  "text": "Twenty nineteen used an estimated",
  "start": 71.12,
  "end": 73.39,
  "seg": 10
 },
 {
  "text": "eighty four to ninety six day",
  "start": 73.42,
  "end": 75.47,
  "seg": 10
 },
 {
  "text": "temperature proxy instead.",
  "start": 75.5,
  "end": 76.66,
  "seg": 10
 },
 {
  "text": "The measured surface signal is",
  "start": 77.9,
  "end": 80.31,
  "seg": 11
 },
 {
  "text": "real.",
  "start": 80.34,
  "end": 81.04,
  "seg": 11
 },
 {
  "text": "Is the explanation?",
  "start": 81.48,
  "end": 82.6,
  "seg": 11
 },
 {
  "text": "The authors modeled a path from",
  "start": 84.28,
  "end": 86.47,
  "seg": 12
 },
 {
  "text": "sunlight to meltwater to a buried",
  "start": 86.5,
  "end": 89.11,
  "seg": 12
 },
 {
  "text": "sliding layer.",
  "start": 89.14,
  "end": 89.94,
  "seg": 12
 },
 {
  "text": "No borehole temperatures were recorded.",
  "start": 91.16,
  "end": 93.42,
  "seg": 13
 },
 {
  "text": "The weather station sat six kilometers",
  "start": 94.22,
  "end": 96.35,
  "seg": 13
 },
 {
  "text": "away.",
  "start": 96.38,
  "end": 97.08,
  "seg": 13
 },
 {
  "text": "Two smaller glaciers broke the",
  "start": 97.82,
  "end": 100.39,
  "seg": 14
 },
 {
  "text": "simple sunlight pattern.",
  "start": 100.42,
  "end": 101.54,
  "seg": 14
 },
 {
  "text": "That does not erase the measurement.",
  "start": 102.34,
  "end": 104.64,
  "seg": 15
 },
 {
  "text": "It turns the result into a",
  "start": 105.62,
  "end": 107.37,
  "seg": 16
 },
 {
  "text": "sharper field test.",
  "start": 107.4,
  "end": 108.62,
  "seg": 16
 },
 {
  "text": "Put sensors underground.",
  "start": 109.38,
  "end": 110.9,
  "seg": 17
 },
 {
  "text": "Watch the next melt and rain.",
  "start": 111.6,
  "end": 113.46,
  "seg": 17
 },
 {
  "text": "See whether the mountain keeps",
  "start": 114.2,
  "end": 115.73,
  "seg": 17
 },
 {
  "text": "both appointments.",
  "start": 115.76,
  "end": 116.62,
  "seg": 17
 }
]